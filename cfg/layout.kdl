layout {
    gaps 8
    center-focused-column "never"

    // Transparent so Noctalia's wallpaper layer shows through.
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Gradient focus ring — drawn around windows that agree to omit CSDs
    // (see `prefer-no-csd` in misc.kdl).
    focus-ring {
        width 3
        active-gradient from="#7aa2f7" to="#bb9af7" angle=45
        inactive-color "#3b4261"
    }

    // A plain border would fight the ring; keep it available but off.
    border {
        off
        width 2
        active-color "#7aa2f7"
        inactive-color "#2a2e3e"
        urgent-color "#f7768e"
    }

    shadow {
        on
        softness 25
        spread 2
        offset x=0 y=5
        color "#00000066"
    }

    struts {}
}

// Blur (niri 26.04+). Kept cheap on this 2017 Polaris GPU: two passes,
// no saturation boost, and xray off so panels blur content instead of the
// wallpaper.
blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

overview {
    workspace-shadow {
        off
    }
}
